    <!-- what went wrong -->
    <string name="err_no_network">Brak połączenia z Claude: telefon nie mógł odnaleźć api.anthropic.com. Sprawdź połączenie z internetem (i czy aplikacja może korzystać z danych mobilnych), a potem spróbuj ponownie.</string>
    <string name="err_cut_off">Połączenie zostało zerwane, gdy Claude pisał. Spróbuj ponownie.</string>
    <string name="err_timeout">Upłynął limit czasu połączenia. Przy słabym sygnale tak bywa; spróbuj ponownie.</string>
    <string name="err_tls">Nie udało się nawiązać bezpiecznego połączenia z Claude. Przyczyną może być VPN, strona logowania do sieci Wi-Fi lub filtrujący DNS.</string>
    <string name="err_bad_key">Claude odrzucił klucz API. Wklej nowy w Ustawienia → Claude.</string>
    <string name="err_forbidden">Claude odrzucił żądanie (403): klucz może nie mieć dostępu albo API jest niedostępne z tej sieci.</string>
    <string name="err_no_credit">Na koncie Anthropic skończyły się środki. Doładuj je w Anthropic Console, a potem spróbuj ponownie.</string>
    <string name="err_rate_limited">Zbyt wiele żądań naraz. Odczekaj minutę i spróbuj ponownie.</string>
    <string name="err_overloaded">Claude jest teraz przeciążony. Spróbuj ponownie za minutę.</string>
    <string name="err_server">Wystąpił błąd serwera Claude. Spróbuj ponownie.</string>
    <string name="err_declined">Model odmówił napisania tego fragmentu. Spróbuj ponownie lub go przepisz.</string>
    <string name="err_unusable">Odpowiedź Claude trzy razy okazała się bezużyteczna. Spróbuj ponownie.</string>
    <string name="err_no_key">Najpierw dodaj klucz API Claude (Ustawienia → Claude).</string>
    <string name="err_other">Coś poszło nie tak.</string>

