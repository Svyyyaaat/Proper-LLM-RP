    <!-- what went wrong -->
    <string name="err_no_network">Claude에 연결할 수 없어요. 휴대전화가 api.anthropic.com을 찾지 못했어요. 인터넷 연결(그리고 이 앱의 모바일 데이터 사용 허용 여부)을 확인한 뒤 다시 시도하세요.</string>
    <string name="err_cut_off">Claude가 쓰는 도중 연결이 끊겼어요. 다시 시도하세요.</string>
    <string name="err_timeout">연결 시간이 초과됐어요. 신호가 약하면 그럴 수 있어요. 다시 시도하세요.</string>
    <string name="err_tls">Claude와의 보안 연결에 실패했어요. VPN, Wi-Fi 로그인 페이지 또는 필터링 DNS 때문일 수 있어요.</string>
    <string name="err_bad_key">Claude가 API 키를 거부했어요. 설정 → Claude에서 새 키를 붙여넣으세요.</string>
    <string name="err_forbidden">Claude가 요청을 거부했어요(403). 키에 접근 권한이 없거나, 이 네트워크에서는 API를 사용할 수 없을 수 있어요.</string>
    <string name="err_no_credit">Anthropic 계정의 크레딧이 부족해요. Anthropic Console에서 크레딧을 추가한 뒤 다시 시도하세요.</string>
    <string name="err_rate_limited">한꺼번에 요청이 너무 많아요. 1분 정도 기다린 뒤 다시 시도하세요.</string>
    <string name="err_overloaded">지금 Claude 사용량이 많아요. 1분 뒤에 다시 시도하세요.</string>
    <string name="err_server">Claude에서 서버 오류가 발생했어요. 다시 시도하세요.</string>
    <string name="err_declined">모델이 이 단락 쓰기를 거절했어요. 다시 시도하거나 다시 쓰기를 해 보세요.</string>
    <string name="err_unusable">Claude의 답변을 세 번 연속 사용할 수 없었어요. 다시 시도하세요.</string>
