    <!-- welcome and setup -->
    <string name="welcome_tagline">반칙 없는 이야기.</string>
    <string name="welcome_body">제대로 된 게임 마스터와 함께하는 롤플레이 스토리. 캐릭터 하나를 연기하면, Claude가 세계와 그 안의 모든 사람을 움직여요.</string>
    <string name="welcome_f1_title">살아 움직이는 세계</string>
    <string name="welcome_f1_body">저마다 목표와 비밀을 가진 사람들, 그리고 자리를 비운 사이에도 계속되는 사건.</string>
    <string name="welcome_f2_title">결정은 화자가 아닌 주사위가</string>
    <string name="welcome_f2_body">위험한 행동은 주사위로 판정해요. 실패하면 진짜 대가를 치러요.</string>
    <string name="welcome_f3_title">어떤 언어든</string>
    <string name="welcome_f3_body">원하는 언어로 쓰세요. 스토리가 그 언어로 답해요.</string>
    <string name="welcome_start">시작하기</string>

    <string name="key_title">Claude 연결</string>
    <string name="key_body_api">Claude가 스토리를 써요. 비용은 Anthropic 계정에서 결제되며, 단락당 몇 센트 정도예요.</string>
    <string name="key_body_cc">Termux의 Claude Code 앱을 통해 Claude 구독으로 Claude가 스토리를 써요.</string>
